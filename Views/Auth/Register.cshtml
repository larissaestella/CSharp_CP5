@model GameStore.Models.RegisterViewModel

@{
    ViewData["Title"] = "Criar Conta";
}

<style>
    body {
        background-color: #0f111a;
    }

    .login-card {
        background-color: #1a1d29;
        border: 1px solid #2d313f;
        border-radius: 8px;
        padding: 2rem;
    }

    .text-white {
        color: #ffffff !important;
    }

    .text-gray {
        color: #8a8d98 !important;
    }

    .label-custom {
        display: block;
        margin-bottom: 5px;
        color: #ffffff;
        font-size: 0.9rem;
    }

    .form-control-dark {
        background-color: #242734;
        border: 1px solid #3f4451;
        color: white !important;
    }

        .form-control-dark:focus {
            background-color: #242734;
            color: #ffffff;
            border-color: #1db954;
            box-shadow: none;
        }

        .form-control-dark::placeholder {
            color: #6c757d !important;
            opacity: 1;
        }

    .btn-green {
        background-color: #1db954;
        border: none;
        color: white;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-green:hover {
            background-color: #17a34a;
            color: white;
        }

    .link-green {
        color: #1db954;
        text-decoration: none;
        font-weight: bold;
    }

        .link-green:hover {
            color: #17a34a;
            text-decoration: underline;
        }

    hr.subtle {
        border-top: 1px solid #2d313f;
        margin: 20px 0;
    }

    input:-webkit-autofill {
        -webkit-text-fill-color: white !important;
        -webkit-box-shadow: 0 0 0px 1000px #242734 inset;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="login-card shadow-lg">

                <div class="text-center mb-4">
                    <h2 class="text-white fw-bold mb-1">Criar Nova Conta</h2>
                    <small class="text-gray">Junte-se à nossa comunidade</small>
                </div>

                <form asp-controller="Auth" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="label-custom">Nome completo</label>
                        <input asp-for="Nome" class="form-control form-control-dark" placeholder="Seu nome completo" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="label-custom">E-mail</label>
                        <input asp-for="Email" type="email" class="form-control form-control-dark" placeholder="seu@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Senha" class="label-custom">Senha</label>
                        <input asp-for="Senha" type="password" class="form-control form-control-dark" placeholder="Sua senha" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmacaoSenha" class="label-custom">Confirmar Senha</label>
                        <input asp-for="ConfirmacaoSenha" type="password" class="form-control form-control-dark" placeholder="Repita sua senha" />
                        <span asp-validation-for="ConfirmacaoSenha" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-green py-2">Cadastrar</button>
                    </div>

                    <hr class="subtle">

                    <div class="text-center">
                        <small class="text-gray">Já tem uma conta?</small><br />
                        <a asp-controller="Auth" asp-action="Login" class="link-green small">
                            Fazer login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>