@model List<Game>

@{
    ViewData["Title"] = "Gerenciar Games";
}

<style>
    /* Estilo do Card Central */
    .management-card {
        background-color: #1a1d29;
        border: 1px solid #2d313f;
        border-radius: 12px;
        padding: 1.5rem;
        overflow: hidden;
    }

    /* Cores Padrão da Loja */
    .text-neon-green {
        color: #00ff88 !important;
        font-weight: 600;
    }

    .text-gray {
        color: #8a8d98 !important;
    }

    /* Botão Principal */
    .btn-neon-green {
        background-color: #00ff88;
        color: #000;
        font-weight: bold;
        border: none;
        border-radius: 6px;
        transition: 0.3s;
    }

        .btn-neon-green:hover {
            background-color: #00cc6a;
            color: #000;
        }

    /* Tabela Personalizada */
    .table-custom {
        color: #ffffff;
        margin-bottom: 0;
    }

        .table-custom thead th {
            background-color: #0f111a;
            color: #8a8d98;
            border-bottom: 2px solid #2d313f;
            border-top: none;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            padding: 1rem;
        }

        .table-custom tbody td {
            background-color: transparent;
            border-bottom: 1px solid #2d313f;
            padding: 1rem;
            vertical-align: middle; /* Centraliza o texto verticalmente com a imagem */
        }
        /* Efeito ao passar o mouse na linha */
        .table-custom tbody tr:hover td {
            background-color: #242734;
        }

    /* Miniatura da Capa do Jogo */
    .game-thumb {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #3f4451;
    }

    /* Botões de Ação da Tabela (Outline) */
    .btn-action-edit {
        background-color: transparent;
        color: #ffb703;
        border: 1px solid #ffb703;
        transition: 0.2s;
    }

        .btn-action-edit:hover {
            background-color: #ffb703;
            color: #000;
        }

    .btn-action-delete {
        background-color: transparent;
        color: #ef233c;
        border: 1px solid #ef233c;
        transition: 0.2s;
    }

        .btn-action-delete:hover {
            background-color: #ef233c;
            color: #fff;
        }
</style>

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-0">Gerenciar Games</h2>
            <small class="text-gray">Controle de inventário e catálogo da loja</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-bold">Voltar</a>
            <a asp-action="Create" class="btn btn-neon-green">+ Novo Game</a>
        </div>
    </div>

    <div class="management-card shadow-lg">
        <div class="table-responsive">
            <table class="table table-custom table-borderless">
                <thead>
                    <tr>
                        <th width="90">Capa</th>
                        <th>Título do Jogo</th>
                        <th>Preço</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in Model)
                    {
                        <tr>
                            <td>
                                <img src="@game.UrlImagem" alt="@game.Titulo" class="game-thumb" />
                            </td>
                            <td class="text-white fw-bold fs-6">@game.Titulo</td>
                            <td class="text-neon-green">R$ @game.Preco.ToString("N2")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@game.Id" class="btn btn-action-edit btn-sm px-3 fw-bold">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@game.Id" class="btn btn-action-delete btn-sm px-3 fw-bold">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-gray mb-0">Nenhum game cadastrado ainda. Clique em "+ Novo Game" para começar.</p>
                </div>
            }
        </div>
    </div>
</div>