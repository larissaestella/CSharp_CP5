@model List<Game>

@{
    ViewData["Title"] = "Games | Home";
}

<style>
    body {
        background-color: #0f111a;
        color: #ffffff;
    }

    .game-card {
        background-color: #1a1d29; 
        border: none;
        border-radius: 12px; 
        overflow: hidden;
    }

    .game-card-img {
        height: 180px;
        object-fit: cover;
        width: 100%;
    }

    .game-title {
        display: -webkit-box;
        -webkit-line-clamp: 2; 
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.5rem; 
    }

    .game-desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 0.8rem; 
        color: #8a8d98; 
    }

    .text-neon-green {
        color: #00ff88 !important; 
        font-weight: 600;
        font-size: 0.95rem;
    }

    .btn-neon-green {
        background-color: #00ff88;
        color: #000000; 
        font-weight: bold;
        border: none;
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-neon-green:hover {
            background-color: #00cc6a;
            color: #000000;
        }

        .btn-neon-green:focus, .btn-neon-green:active {
            box-shadow: none !important;
        }
</style>

<div class="p-5 mb-4 bg-dark rounded-3 jumbotron-hero"
     style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
            url('/img/fundo.jpg') no-repeat center/cover;">
    <div class="container-fluid py-5 text-white">
        <h1 class="display-5 fw-bold">Domine o Jogo</h1>
        <p class="col-md-8 fs-4">Os lançamentos mais esperados e as melhores ofertas em um só lugar. Upgrade no seu setup começa aqui.</p>
        <button class="btn btn-neon-green btn-lg" type="button">Ver Ofertas</button>
    </div>
</div>

<div class="container mb-5">
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <span class="badge rounded-pill bg-secondary p-2 px-3">RPG</span>
        <span class="badge rounded-pill bg-secondary p-2 px-3">Ação</span>
        <span class="badge rounded-pill bg-secondary p-2 px-3">Corrida</span>
        <span class="badge rounded-pill bg-secondary p-2 px-3">Aventura</span>
    </div>
</div>

<div class="container">
    <h4 class="mb-4 text-white fw-bold">Em Destaque</h4>

    @if (User.IsInRole("Admin"))
    {
        <div class="mt-2 text-start mb-4 d-flex gap-2">
            <a asp-controller="Game" asp-action="Create" class="btn btn-neon-green">
                + Cadastrar Novo Game
            </a>
            <a asp-controller="Game" asp-action="Index" class="btn btn-outline-light fw-bold">
                ⛯ Gerenciar Games
            </a>
        </div>
    }

    <div class="row">
        @foreach (var game in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card game-card shadow h-100">

                    <img src="@game.UrlImagem" class="game-card-img" alt="@game.Titulo" />

                    <div class="card-body p-3 d-flex flex-column">

                        <div>
                            <h6 class="text-white fw-bold mb-1 game-title" title="@game.Titulo">@game.Titulo</h6>

                            <p class="game-desc mb-2" title="@game.Descricao">@game.Descricao</p>

                            <p class="text-neon-green mb-3">R$ @game.Preco.ToString("N2")</p>
                        </div>

                        <div class="mt-auto">
                            <div class="d-grid">
                                <button class="btn btn-neon-green py-2">Comprar</button>
                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <hr class="border-secondary mt-3 mb-2" />
                                <div class="d-flex justify-content-between gap-2 mt-2">
                                    <a asp-controller="Game" asp-action="Edit" asp-route-id="@game.Id" class="btn btn-outline-warning btn-sm w-50">Editar</a>
                                    <a asp-controller="Game" asp-action="Delete" asp-route-id="@game.Id" class="btn btn-outline-danger btn-sm w-50">Excluir</a>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>